---
import type { TypeCosmicProperty } from "@lib/types/Database";
import PropertyCard from "src/components/global/property-card/PropertyCard";

interface Props {
  properties: TypeCosmicProperty[];
  className?: string;
}

const { properties, className = "" } = Astro.props;
---

<div class={`swiper properties-swiper py-3 ${className}`}>
  <div class="swiper-wrapper">
    {
      properties.map((property) => (
        <div class="swiper-slide max-w-[350px]">
          <PropertyCard client:load property={property} />
        </div>
      ))
    }
  </div>
</div>

<script>
  import Swiper from "swiper/bundle";
  new Swiper(".properties-swiper", {
    cssMode: true,
    slidesPerView: "auto",
    spaceBetween: 15,
  });
</script>
