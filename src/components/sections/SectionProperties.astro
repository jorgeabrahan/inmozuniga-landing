---
import Delimiter from "@layouts/Delimiter.astro";
import SectionTitleHeader from "src/components/global/SectionTitleHeader.astro";
import ArrowLink from "src/components/global/ArrowLink.astro";
import { ServiceProperties } from "src/services/ServiceProperties";
import {
  PROPERTY_AVAILABILITY_KEYS,
  PROPERTY_CATEGORY_KEYS,
} from "@lib/constants/property";
import PropertiesSwiper from "./section-properties/PropertiesSwiper";

interface Props {
  className?: string;
}

const { className = "" } = Astro.props;

const { data: propertiesForSale } = await ServiceProperties.getProperties({
  availability: PROPERTY_AVAILABILITY_KEYS.sale,
  category: PROPERTY_CATEGORY_KEYS.house,
});
const { data: propertiesForRent } = await ServiceProperties.getProperties({
  availability: PROPERTY_AVAILABILITY_KEYS.rent,
});
---

<Delimiter className={className}>
  <SectionTitleHeader
    subtitle="Explora nuestras propiedades y encuentra el hogar perfecto que se adapte a tus necesidades"
  >
    Nuestras <span class="text-harvest-gold-700">propiedades</span>
  </SectionTitleHeader>
  <PropertiesSwiper
    client:load
    className="mb-8"
    properties={propertiesForSale}
  />
  <PropertiesSwiper
    client:load
    className="mb-8"
    properties={propertiesForRent}
  />
  <ArrowLink
    className="mx-auto"
    url="/propiedades"
    text="Ver más Propiedades"
  />
</Delimiter>
