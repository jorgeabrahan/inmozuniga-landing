---
import MainLinkAsButton from "../global/MainLinkAsButton.astro";
interface Props {
  className?: string;
}
const { className } = Astro.props;
---

<section
  class={`bg-[url('/assets/images/general/sell-property.webp')] min-h-[700px] md:min-h-[900px] xl:min-h-[1000px] bg-no-repeat bg-cover bg-center bg-fixed relative ${className}`}
>
  <svg class="absolute top-0 left-0 w-full z-20" viewBox="0 0 1440 220"
    ><path
      fill="#ffffff"
      fill-opacity="1"
      d="M0,192L80,170.7C160,149,320,107,480,101.3C640,96,800,128,960,144C1120,160,1280,160,1360,160L1440,160L1440,0L1360,0C1280,0,1120,0,960,0C800,0,640,0,480,0C320,0,160,0,80,0L0,0Z"
    ></path></svg
  >
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm z-10">
    <article
      class="absolute top-1/2 -translate-y-1/2 left-1/2 -translate-x-1/2 w-[calc(100%-24px)] lg:w-[calc(100%-48px)] xl:w-[calc(100%-64px)] space-y-4"
    >
      <div
        class="w-full lg:max-w-[700px] lg:ml-auto bg-white/75 backdrop-blur-3xl p-10 rounded-lg space-y-4"
      >
        <h2 class="text-4xl md:text-5xl leading-9 font-bold capitalize">
          Vende tu Propiedad
        </h2>
        <p class="text-xl font-light">
          Somos expertos en el mercado inmobiliario. Vende rápido y al mejor
          precio. ¡Contáctanos hoy!
        </p>
        <MainLinkAsButton url="/#contact-section" text="Contáctanos" />
      </div>
    </article>
  </div>
  <svg class="absolute bottom-0 left-0 w-full z-20" viewBox="0 0 1440 220"
    ><path
      fill="#ffffff"
      fill-opacity="1"
      d="M0,192L80,170.7C160,149,320,107,480,101.3C640,96,800,128,960,144C1120,160,1280,160,1360,160L1440,160L1440,320L1360,320C1280,320,1120,320,960,320C800,320,640,320,480,320C320,320,160,320,80,320L0,320Z"
    ></path></svg
  >
</section>
