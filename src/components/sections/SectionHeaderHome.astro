---
import Delimiter from "@layouts/Delimiter.astro";

interface Props {
  className?: string;
}
const { className = "" } = Astro.props;
---

<header class={`relative ${className}`}>
  <video
    class="w-full min-h-[600px] lg:min-h-[100vh] xl:min-h-[120vh] object-cover"
    autoplay
    muted
    loop
    playsinline
  >
    <source src="/assets/videos/closing-deal.mp4" type="video/mp4" />
    Your browser does not support the video tag.
  </video>
  <svg class="absolute -bottom-[2px] left-0 w-full z-10" viewBox="0 0 1440 320"
    ><path
      fill="#ffffff"
      fill-opacity="1"
      d="M0,256L60,240C120,224,240,192,360,186.7C480,181,600,203,720,224C840,245,960,267,1080,261.3C1200,256,1320,224,1380,208L1440,192L1440,320L1380,320C1320,320,1200,320,1080,320C960,320,840,320,720,320C600,320,480,320,360,320C240,320,120,320,60,320L0,320Z"
    ></path></svg
  >
  <!-- overlay -->
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm">
    <Delimiter className="h-full flex flex-col justify-center pb-20">
      <div>
        <h1
          class="text-white flex flex-col text-7xl lg:text-9xl xl:text-[140px] font-emphasis font-bold uppercase mb-4"
        >
          <span>Tu Felicidad</span>
          <span>Empieza Aqui</span>
        </h1>
        <h2
          class="text-harvest-gold-400 text-lg lg:text-xl xl:text-2xl font-light"
        >
          Nuestros agentes inmobiliarios expertos encontrarán el hogar perfecto
          para ti
        </h2>
      </div>
    </Delimiter>
  </div>
</header>
