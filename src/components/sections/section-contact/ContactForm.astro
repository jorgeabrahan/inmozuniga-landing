---
import Input from "src/components/global/fields/Input.astro";
import Select from "src/components/global/fields/Select.astro";
import Textarea from "src/components/global/fields/Textarea.astro";
import MainButton from "src/components/global/MainButton.astro";
---

<form class="w-full flex-1" data-id="contact-form">
  <h2 class="text-4xl md:text-5xl font-bold md:leading-[3rem] mb-5">
    Agenda una <span class="text-harvest-gold-600">cita</span>
  </h2>
  <p class="text-black-600 max-w-[800px] sm:text-lg md:text-xl mb-10 lg:mb-14">
    Nuestros agentes están listos para ayudarte en todo lo que necesites, agenda
    una cita y te ayudaremos a encontrar la mejor solución para tus necesidades.
  </p>
  <div class="flex flex-col gap-6 mb-8">
    <Input id="name" label="Nombre" placeholder="Jorge Sigüenza" required />
    <Input id="phone" type="tel" label="Teléfono" required />
    <Input
      id="email"
      type="email"
      label="Correo electrónico"
      placeholder="jorge@gmail.com"
      required
    />
    <Select
      id="clientType"
      label="Tipo de cliente"
      options={[
        { value: "particular", label: "Particular" },
        { value: "inversionista", label: "Inversionista" },
      ]}
    />
    <Select
      id="purpose"
      label="Objetivo de la cita"
      options={[
        { value: "vender", label: "Vender" },
        { value: "rentar", label: "Rentar" },
        { value: "comprar", label: "Comprar" },
        { value: "asesoria", label: "Asesoría" },
        { value: "otro", label: "Otro" },
      ]}
    />
    <Textarea
      id="message"
      label="Comentario adicional"
      placeholder="Quiero adquirir un terreno para construir mi hogar"
    />
  </div>
  <MainButton text="Agendar ahora" type="submit" />
</form>

<script>
  import { toast } from "sonner";
  import { intlTelInputSettings } from "@lib/constants";
  import { UtilsFormat } from "@lib/utils/UtilsFormat";

  const contactForms = document.querySelectorAll(
    "form[data-id='contact-form']",
  ) as NodeListOf<HTMLFormElement>;
  contactForms?.forEach((contactForm) => {
    if (!contactForm) return;
    const intl = window.intlTelInput(contactForm.phone, intlTelInputSettings);
    contactForm.addEventListener("submit", (e) => {
      e.preventDefault();
      if (!e.target) return;
      const data = Object.fromEntries(
        new FormData(e.target as HTMLFormElement),
      ) as {
        name: string;
        phone: string;
        email: string;
      };
      if (!intl.isValidNumber()) {
        toast.error("Numero de teléfono invalido");
        return;
      }
      data.name = UtilsFormat.capitalize(data.name);
      data.phone = intl.getNumber();
      data.email = data.email.trim().toLowerCase();

      // TODO: send data to email marketing
    });
  });
</script>
