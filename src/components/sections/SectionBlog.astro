---
import Delimiter from "@layouts/Delimiter.astro";
import ArrowLink from "src/components/global/ArrowLink.astro";
import WrapperWaves from "./section-blog/WrapperWaves.astro";
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<WrapperWaves className={className}>
  <Delimiter>
    <h2 class="text-4xl md:text-5xl text-white font-bold mb-6">
      Nuestro <span class="text-harvest-gold-400">Blog</span>
    </h2>
    <p class="text-white/80 sm:text-2xl mb-10">
      Explora nuestros artículos llenos de recomendaciones y consejos basados en
      nuestra amplia experiencia en el sector inmobiliario.
      <br /><br />
      Encuentra información útil y actualizada para ayudarte en tu búsqueda de propiedades.
    </p>
    <ArrowLink
      url="https://blog.inmozuniga.com"
      target="_blank"
      text="Leer blogs"
      rel="noopener noreferrer"
      isBackgroundDark
    />
  </Delimiter>
</WrapperWaves>
