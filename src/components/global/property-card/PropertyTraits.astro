---
import BedIcon from "@icons/BedIcon.astro";
import BathroomIcon from "@icons/BathroomIcon.astro";
import CarIcon from "@icons/CarIcon.astro";
import RulerIcon from "@icons/RulerIcon.astro";
import PropertyTrait from "./PropertyTrait.astro";
import type { TypeCosmicProperty } from "@lib/types/Database";
interface Props {
  property: TypeCosmicProperty;
}
const { property } = Astro.props;
---

<section class="flex items-center gap-4">
  <PropertyTrait trait={property.metadata.traits.bedrooms} title="Habitaciones">
    <BedIcon size="20px" />
  </PropertyTrait>
  <PropertyTrait trait={property.metadata.traits.bathrooms} title="Baños">
    <BathroomIcon size="20px" />
  </PropertyTrait>
  <PropertyTrait
    trait={property.metadata.traits.parking_lots}
    title="Estacionamientos"
  >
    <CarIcon size="20px" />
  </PropertyTrait>
  <PropertyTrait
    trait={property.metadata.measurements.meters}
    title="Metros de construcción"
  >
    <RulerIcon size="20px" />
    <span slot="unit-measurement">m&sup2;</span>
  </PropertyTrait>
  {
    !(property.metadata.measurements.meters > 0) && (
      <PropertyTrait
        trait={property.metadata.measurements.rods}
        title="Varas de terreno"
      >
        <RulerIcon size="20px" />
        <span slot="unit-measurement">v&sup2;</span>
      </PropertyTrait>
    )
  }
</section>
