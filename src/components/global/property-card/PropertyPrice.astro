---
import { PROPERTY_AVAILABILITY } from "@lib/constants/property";
import { UtilsFormat } from "@lib/utils/UtilsFormat";

interface Props {
  propertyState: (typeof PROPERTY_AVAILABILITY)[keyof typeof PROPERTY_AVAILABILITY];
  propertyPrice: {
    fee: number;
    total: number;
  };
}

const { propertyState, propertyPrice } = Astro.props;
---

<div class="mb-1 flex flex-col">
  <p class="font-light capitalize text-xs leading-[8px]">
    {propertyState === PROPERTY_AVAILABILITY.rent ? "Cuota" : "Costo total"}
  </p>
  <p class="text-2xl font-light">
    {
      UtilsFormat.asCurrency(
        propertyState === PROPERTY_AVAILABILITY.rent
          ? propertyPrice.fee
          : propertyPrice.total,
      )
    }
  </p>
</div>
