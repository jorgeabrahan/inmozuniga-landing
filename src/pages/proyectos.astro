---
export const prerender = false;

import { ServiceProjects } from "src/services/ServiceProjects";
import Layout from "../layouts/Layout.astro";
import { meta } from "../lib/constants/meta";
import Delimiter from "@layouts/Delimiter.astro";
import MapPinIcon from "@icons/MapPinIcon.astro";
import ProjectCardLink from "src/components/global/project-card/ProjectCardLink.astro";
import { ProjectDetails } from "src/components/page/projects/ProjectDetails";
import InfoCircleIcon from "@icons/InfoCircleIcon.astro";

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=0, s-maxage=86400, stale-while-revalidate=3600",
);
const { data } = await ServiceProjects.getProjects();
---

<Layout
  title={meta.proyectos.title}
  description={meta.proyectos.description}
  keywords={meta.proyectos.keywords}
>
  <Delimiter
    className="relative grid lg:grid-cols-7 gap-6 lg:gap-8 pt-10 pb-44"
  >
    <section class="col-span-4 grid gap-12 md:gap-6">
      {
        data.map((project) => (
          <div
            class="project-card cursor-pointer select-none bg-white hover:-translate-y-2 transition-transform w-full h-[400px] md:h-[300px] rounded-xl grid md:grid-cols-12 lg:grid-cols-2 gap-4 border-2 border-[#e5e5e5] sticky top-32"
            data-project-slug={project.slug}
          >
            <div class="p-4 flex flex-col justify-center md:col-span-7 lg:col-span-1 order-1 md:-order-1">
              <h2 class="text-3xl font-semibold md:text-right mb-2">
                {project.title}
              </h2>
              <p class="text-gray-500 md:text-right mb-4">
                {project.metadata.description}
              </p>
            </div>
            <figure class="relative rounded-tl-xl md:rounded-tl-none rounded-tr-xl md:rounded-br-xl overflow-hidden h-full max-h-full w-full md:col-span-5 lg:col-span-1">
              <img
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                src={project.thumbnail}
                alt={project.title}
              />
              <div class="absolute bottom-0 left-0 right-0 w-full px-3 pb-3 md:px-4 md:pb-4 pt-10 bg-gradient-to-t from-black/70 to-black/0 text-white flex items-center justify-end gap-3 md:gap-5">
                <ProjectCardLink
                  href={`https://www.google.com/maps?q=${project.metadata.coordinates.latitude},${project.metadata.coordinates.longitude}&t=k`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <MapPinIcon size="20px" />
                  Ubicación
                </ProjectCardLink>
                <button
                  class="text-sm flex items-center gap-1 hover:scale-105 transition-transform project-details-button"
                  data-project-slug={project.slug}
                >
                  <InfoCircleIcon size="20px" />
                  Detalles
                </button>
              </div>
            </figure>
          </div>
        ))
      }
    </section>
    <aside class="-order-1 lg:order-1 col-span-3">
      <h1
        class="text-6xl md:text-[6rem] mb-16 lg:mb-0 lg:text-[5rem] xl:text-[6rem] leading-[1.1] font-semibold lg:sticky top-32 flex flex-col justify-center"
      >
        Conoce
        <span class="text-harvest-gold">Nuestros</span>
        Proyectos
      </h1>
    </aside>
  </Delimiter>
  <ProjectDetails allProjects={data} client:only="react" />
</Layout>

<script>
  const projectCards = document.querySelectorAll(".project-card");
  const projectDetailsButtons = document.querySelectorAll(
    ".project-details-button",
  );

  projectCards.forEach((card) => {
    card.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (target == null) return;
      const clickedInsideLink = target.closest("a");
      const clickedInsideButton = target.closest("button");

      if (clickedInsideLink || clickedInsideButton) return;
      const projectSlug = card.getAttribute("data-project-slug");
      window.history.pushState(null, "", `?projectSlug=${projectSlug}`);
    });
  });
  projectDetailsButtons.forEach((projectDetailsButton) => {
    projectDetailsButton?.addEventListener("click", () => {
      const projectSlug =
        projectDetailsButton.getAttribute("data-project-slug");
      window.history.pushState(null, "", `?projectSlug=${projectSlug}`);
    });
  });

  (function (history) {
    const pushState = history.pushState;
    history.pushState = function (state, title, url) {
      const result = pushState.apply(history, [state, title, url]);
      window.dispatchEvent(new Event("locationchange"));
      return result;
    };
  })(window.history);
</script>
