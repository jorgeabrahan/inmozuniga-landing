---
export const prerender = false;

import "swiper/css/bundle";
import Layout from "@layouts/Layout.astro";
import { meta } from "@lib/constants/meta";
import SectionQuoter from "src/components/sections/SectionQuoter.astro";
import SectionProperties from "src/components/sections/SectionProperties.astro";
import SectionProjects from "src/components/sections/SectionProjects.astro";
import SectionBlog from "src/components/sections/SectionBlog.astro";
import SectionContact from "src/components/sections/SectionContact.astro";
import SectionHeaderHome from "src/components/sections/SectionHeaderHome.astro";
import SectionSellYourProperty from "src/components/sections/SectionSellYourProperty.astro";
---

<Layout
  title={meta.index.title}
  description={meta.index.description}
  keywords={meta.index.description}
>
  <main>
    <SectionHeaderHome className="mb-36 xl:mb-56" />
    <SectionProperties className="mb-36 xl:mb-56" />
    <SectionSellYourProperty className="mb-36 xl:mb-56" />
    <SectionProjects className="mb-36 xl:mb-56" />
    <SectionQuoter className="mb-36 xl:mb-56" />
    <SectionContact className="mb-36 xl:mb-56" />
    <SectionBlog className="mb-36 xl:mb-56" />
  </main>
</Layout>
