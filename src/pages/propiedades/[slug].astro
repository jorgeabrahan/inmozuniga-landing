---
export const prerender = false;

import Delimiter from "@layouts/Delimiter.astro";
import Layout from "@layouts/Layout.astro";
import { meta } from "@lib/constants";
import { UtilsFormat } from "@lib/utils/UtilsFormat";
import { PropertySwiper } from "src/components/page/property/PropertySwiper";
import { ServiceProperties } from "src/services/ServiceProperties";

const { slug } = Astro.params;
const { data } = await ServiceProperties.getProperty(slug || "");

if (!data) {
  throw Astro.redirect("/propiedades", 302);
}

const MAX_CHARS = 350;
const fullDescription = data.metadata.description || "";
const plainTextDescription = UtilsFormat.asPlainText(fullDescription);
const truncated = plainTextDescription.length > MAX_CHARS;
const shortDescription = truncated
  ? plainTextDescription.substring(0, MAX_CHARS) + "..."
  : plainTextDescription;
---

<Layout
  title={meta.propiedad.title}
  description={meta.propiedad.description}
  keywords={meta.propiedad.keywords}
  >2
  <PropertySwiper property={data} client:load />
  <Delimiter className="flex flex-col lgx:flex-row gap-6 relative mt-10">
    <h1 class="font-emphasis text-3xl font-bold">{data.title}</h1>
    <div
      class="description"
      set:html={truncated ? shortDescription : fullDescription}
    />
    {
      truncated && (
        <button
          class="mt-4 text-blue-600 font-medium hover:underline"
          id="showMoreBtn"
        >
          Mostrar más
        </button>
      )
    }
    <div set:html={data.metadata.location} />
  </Delimiter>
</Layout>
