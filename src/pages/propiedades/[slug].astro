---
export const prerender = false;

import Delimiter from "@layouts/Delimiter.astro";
import Layout from "@layouts/Layout.astro";
import { meta } from "@lib/constants";
import PropertyTraits from "src/components/page/property/PropertyTraits";
import { PropertySwiper } from "src/components/page/property/PropertySwiper";
import { ServiceProperties } from "src/services/ServiceProperties";
import { PropertyDescription } from "src/components/page/property/PropertyDescription";
import { PropertyTag } from "src/components/page/property/PropertyTag";
import { PROPERTY_AVAILABILITY_KEYS } from "@lib/constants/property";
import { UtilsFormat } from "@lib/utils/UtilsFormat";
import { HomeAltIcon } from "@icons/HomeAltIcon";
import { LabelIcon } from "@icons/LabelIcon";
import { HomeSaleIcon } from "@icons/HomeSaleIcon";
import PropertyContactActions from "src/components/page/property/PropertyContactActions.astro";
import PropertyTags from "src/components/page/property/PropertyTags.astro";
import { PropertyQuoter } from "src/components/page/property/PropertyQuoter";

const { slug } = Astro.params;
const { data } = await ServiceProperties.getProperty(slug || "");

if (!data) {
  throw Astro.redirect("/propiedades", 302);
}

const isForSale =
  data.metadata.availability.key === PROPERTY_AVAILABILITY_KEYS.sale;
const prices = data.metadata.prices;
const price = isForSale ? prices.total : prices.installment;
---

<Layout
  title={meta.propiedad.title}
  description={meta.propiedad.description}
  keywords={meta.propiedad.keywords}
>
  <PropertySwiper property={data} client:load />
  <Delimiter
    className="grid lg:grid-cols-7 xl:grid-cols-8 gap-8 relative mt-10"
  >
    <div class="lg:col-span-4 xl:col-span-5">
      <h1 class="text-3xl font-semibold mb-4">{data.title}</h1>
      <PropertyDescription
        description={data.metadata.description}
        client:only="react"
      />
      <hr class="mt-8" />
      <PropertyTraits property={data} />
      <hr class="mb-8" />
      <div
        class="rounded-xl overflow-hidden"
        set:html={data.metadata.location}
      />
    </div>
    <div class="lg:col-span-3 relative">
      <div class="lg:sticky top-36">
        <section
          class="hidden lg:block rounded-2xl bg-white shadow-[0_0_15px_rgba(0,0,0,0.1)] p-8 mb-8"
        >
          <PropertyTags data={data} />
          <hr class="my-6" />
          <p class="text-center">
            <span class="text-4xl block font-emphasis">
              {UtilsFormat.asCurrency(price)}
            </span>
            <span class="font-emphasis"
              >{isForSale ? "Costo total" : "Cuota mensual"}</span
            >
          </p>
          <hr class="my-6" />
          <PropertyContactActions data={data} />
        </section>
        {
          data.metadata.availability.key ===
            PROPERTY_AVAILABILITY_KEYS.sale && (
            <section class="rounded-2xl bg-white shadow-[0_0_15px_rgba(0,0,0,0.1)] p-8">
              <PropertyQuoter property={data} client:only="react" />
            </section>
          )
        }
      </div>
    </div>
    <div
      class="fixed z-20 p-3 bottom-0 left-0 right-0 w-full lg:hidden bg-white"
    >
      <PropertyTags data={data} className="mb-2" />
      <div class="flex items-center justify-between">
        <div>
          <p class="font-emphasis text-xs -mb-1">
            {isForSale ? "Costo total" : "Cuota mensual"}
          </p>
          <p class="text-2xl block font-emphasis">
            {UtilsFormat.asCurrency(price)}
          </p>
        </div>
        <PropertyContactActions data={data} isMinimal />
      </div>
    </div>
  </Delimiter>
</Layout>
